APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_VISION_PROJECT_ID=
GOOGLE_VISION_CREDENTIALS=
GOOGLE_VISION_API_KEY=

OCR_MAX_FILE_SIZE_KB=5120
OCR_ALLOW_WEBP=false
OCR_RATE_LIMIT_PER_MINUTE=30
OCR_POSTCODE_MAP_PATH=
OCR_VISION_TIMEOUT_SECONDS=20
OCR_VISION_CONNECT_TIMEOUT_SECONDS=5
OCR_VISION_RETRY_TIMES=2
OCR_VISION_RETRY_SLEEP_MS=250
OCR_REQUEST_MAX_EXECUTION_SECONDS=120
OCR_PREPROCESS_ENABLE=true
OCR_PREPROCESS_MAX_DIMENSION=2200
OCR_PREPROCESS_MAX_BYTES_FOR_DIRECT=3145728
OCR_PREPROCESS_JPEG_QUALITY=80
OCR_PREPROCESS_PNG_COMPRESSION=6
OCR_PREPROCESS_WEBP_QUALITY=80
OCR_ENABLE_CONFIDENCE_GATE=true
OCR_CONFIDENCE_MIN_OVERALL=0.55
OCR_CONFIDENCE_MIN_FIELD=0.50
OCR_PROVIDER=google_vision
GOOGLE_VISION_API_KEY=
GEMINI_API_KEY=
OCR_GEMINI_MODEL=gemini-2.5-flash
OCR_GEMINI_TIMEOUT_SECONDS=30
OCR_USAGE_CURRENCY=MYR
OCR_USAGE_UNIT=image
OCR_ESTIMATED_PRICE_PER_IMAGE_RM=0.00
OCR_ESTIMATED_PRICE_PER_IMAGE_RM_GOOGLE_VISION=0.00
OCR_ESTIMATED_PRICE_PER_IMAGE_RM_GEMINI=0.00
OCR_ESTIMATED_PRICE_PER_1K_TOKENS_RM_GEMINI_INPUT=0.00
OCR_ESTIMATED_PRICE_PER_1K_TOKENS_RM_GEMINI_OUTPUT=0.00
OCR_GEMINI_INPUT_USD_PER_1M_TOKENS=0.30
OCR_GEMINI_OUTPUT_USD_PER_1M_TOKENS=2.50
OCR_USD_TO_MYR_RATE=4.70
